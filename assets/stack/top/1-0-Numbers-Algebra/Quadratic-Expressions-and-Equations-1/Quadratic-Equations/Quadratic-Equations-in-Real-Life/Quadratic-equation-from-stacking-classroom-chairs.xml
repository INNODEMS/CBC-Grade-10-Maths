    <questionvariables>
      <text><![CDATA[/* Design backwards from a nice positive root r (seats per row).
   Fixed leading coefficient 2 makes the quadratic genuinely NON-MONIC.
   b is ODD, which guarantees the 2 does not factor out (matches the (2x-1) style). */
b : rand([1,3,5,7]);
/* choose r so that the number of rows (2r - b) is at least 2 and total stays reasonable */
r : b + rand(4) + 2;          /* r >= b+2, so rows = 2r - b >= b+4 >= 5 */
rows : 2*r - b;               /* number of rows when x = r */
T : r*rows;                   /* total seats */

/* standard-form expression and equation */
expr : 2*x^2 - b*x - T;
qeq  : expr = 0;

/* factored form for the worked solution: (x - r)(2x + (2r - b)) */
sfac : 2*r - b;               /* the s in (2x + s) */
qeq_factored : (x - r)*(2*x + sfac) = 0;

/* solutions */
sol : r;                      /* the meaningful (positive) root */
negroot : -sfac/2;            /* the rejected negative root */

/* --- distractors for the EQUATION part (a) --- */
me1 : 2*x^2 - b*x = T;        /* not rearranged to = 0 */
me2 : x*(2*x - b) = T;        /* correct relationship but unexpanded / not standard form */
me3 : 2*x^2 - b*x + T = 0;    /* sign error on the total */
me4 : expr;                   /* wrote the expression only, forgot "= 0" */

/* --- distractors for the SOLUTION part (b) --- */
ms1 : negroot;                /* gave the negative root */
ms3 : rows;                   /* number of rows (2x - b); also the x=s slip, same value */]]></text>
    </questionvariables>
