<quiz>
  <question type="stack">
    <name>
      <text>Finding the area of a triangle using two sides and an included angle</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>
Find the area of the triangle below with sides <b>{@a@} cm</b> and <b>{@b@} cm</b> and an included angle of <b>{@C_deg@}&deg;</b>.
</p>

[[jsxgraph]]
    var a = {#a#};
    var b = {#b#};
    var C_deg = {#C_deg#};
    var C_rad = C_deg * Math.PI / 180;
    
    // Calculate triangle vertices
    var p1x = 0; var p1y = 0;
    var p2x = b; var p2y = 0;
    var p3x = a * Math.cos(C_rad);
    var p3y = a * Math.sin(C_rad);
    
    // Dynamic Bounding Box to handle both acute and obtuse angles
    var minX = Math.min(-2, p3x - 2);
    var maxX = Math.max(b + 3, p3x + 3);
    var maxY = p3y + 3;
    var minY = -2;
    
    var board = JXG.JSXGraph.initBoard(BOARDID, {
        boundingbox: [minX, maxY, maxX, minY],
        keepAspectRatio: true,
        showNavigation: false,
        showCopyright: false
    });
    
    var p1 = board.create('point', [p1x, p1y], {visible: false});
    var p2 = board.create('point', [p2x, p2y], {visible: false});
    var p3 = board.create('point', [p3x, p3y], {visible: false});
    
    // Draw Triangle
    var poly = board.create('polygon', [p1, p2, p3], {
        fillColor: '#e0f7fa', fillOpacity: 0.6, 
        borders: {strokeColor: '#006064', strokeWidth: 2.5}
    });
    
    // Draw Included Angle
    var ang = board.create('angle', [p2, p1, p3], {
        radius: Math.min(a, b) * 0.3, 
        name: C_deg + "°",
        fillColor: '#80deea', fillOpacity: 0.8, strokeColor: '#006064'
    });
    
    // Clean Text Labels
    board.create('text', [b/2, -0.5, b + " cm"], {anchorX: 'middle', anchorY: 'top', fontSize: 15});
    board.create('text', [p3x/2 - 0.5, p3y/2 + 0.5, a + " cm"], {anchorX: 'right', anchorY: 'bottom', fontSize: 15});
[[/jsxgraph]]

<p>
Give your answer correct to <b>2 decimal places</b>.
</p>

<p>
Area = [[input:ans1]] <b>\(\text{cm}^2\)</b> [[validation:ans1]] [[feedback:prt1]]
</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text><![CDATA[<h3>Worked Solution</h3>

<p>
<strong>Step 1: Use the sine rule for the area of a triangle.</strong>
</p>

<p>
\[
\text{Area} = \frac{1}{2}ab\sin C
\]
</p>

<p>
<strong>Step 2: Substitute the known values.</strong>
</p>

<p>
The two known sides are \(a = {@a@}\) and \(b = {@b@}\), and the included angle is \(C = {@C_deg@}^\circ\).
</p>

<p>
\[
\text{Area} = \frac{1}{2} \times {@a@} \times {@b@} \times \sin({@C_deg@}^\circ)
\]
</p>

<p>
<strong>Step 3: Evaluate.</strong>
</p>

<p>
\[
\text{Area} \approx {@Area_disp@} \text{ cm}^2
\]
</p>]]></text>
    </generalfeedback>
