    <questionvariables>
      <text>/* Sides */
a: rand(6) + 4;
b: rand(6) + 5;

/* Angle */
C_deg: rand([30, 45, 60, 120, 135, 150]);
C_rad: C_deg * %pi / 180;

/* Area calculated natively as float */
Area_float: float(0.5 * a * b * sin(C_rad));

/* Display variable formatted to exactly 2 decimal places */
Area_disp: dispdp(Area_float, 2);

/* Mistakes evaluated as floats */
m1: float(a * b * sin(C_rad));
m2: float(0.5 * a * b * abs(cos(C_rad)));
m3: float(0.5 * (a + b) * sin(C_rad));</text>
    </questionvariables>
