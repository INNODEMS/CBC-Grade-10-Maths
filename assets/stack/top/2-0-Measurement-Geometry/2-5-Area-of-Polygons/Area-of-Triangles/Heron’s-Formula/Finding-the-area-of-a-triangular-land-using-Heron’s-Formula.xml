    <questionvariables>
      <text><![CDATA[/* Field sides */
a: rand(10) + 15;
b: rand(10) + 18;
c: rand(10) + 20;

/* Ensure strict triangle inequality */
while a + b <= c or a + c <= b or b + c <= a do (
  a: rand(10) + 15,
  b: rand(10) + 18,
  c: rand(10) + 20
);

/* Semi-perimeter (kept exact for standard algebraic display in feedback) */
s: (a + b + c)/2;

/* Area calculated natively as float */
A_float: float(sqrt(s*(s-a)*(s-b)*(s-c)));

/* Display variable formatted to exactly 2 decimal places */
A_disp: dispdp(A_float, 2);

/* Mistakes evaluated as floats for PRT grading */
m1: float(a*b*c);
m2: float(s*(s-a)*(s-b)*(s-c)); /* Forgot square root */
m3: float((a+b+c)/2);           /* Just semi-perimeter */
m4: float(sqrt(a*b));           /* Wrong formula */]]></text>
