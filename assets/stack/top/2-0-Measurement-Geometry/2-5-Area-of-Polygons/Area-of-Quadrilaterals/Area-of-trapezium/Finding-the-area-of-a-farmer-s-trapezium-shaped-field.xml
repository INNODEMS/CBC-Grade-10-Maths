    <questionvariables>
      <text>/* Parallel sides */
a : rand(6) + 10;
b : rand(5) + 4;

/* Height */
h : rand(5) + 4;

/* Geometry */
diff : (a - b)/2;
slant : float(sqrt(h^2 + diff^2));

/* Area evaluated natively as float */
Area_float : float(0.5*(a + b)*h);
Area_disp : dispdp(Area_float, 2);

/* --- Common mistakes evaluated as floats --- */
/* 1. Missing 1/2 factor */
mistake1 : float((a + b)*h);

/* 2. Using slanted side instead of height */
mistake2 : float(0.5*(a + b)*slant);

/* 3. Adding all four sides (treating like perimeter idea) */
mistake3 : float(0.5*(a + b + 2*slant)*h);</text>
    </questionvariables>
