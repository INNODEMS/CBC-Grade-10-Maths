    <questionvariables>
      <text><![CDATA[/* Length and width as decimals */
l: float((rand(120)+90)/10);
w: float((rand(50)+30)/10);

/* Display formatting to prevent floating-point artifacts */
l_disp: dispdp(l, 1);
w_disp: dispdp(w, 1);

/* Area calculated natively as float */
A_float: float(l * w);

/* Rounded display answer (2 d.p.) */
A_disp: dispdp(A_float, 2);

/* Context */
crop: rand(["vegetables","flowers","maize","spinach","kales"]);

/* Mistakes evaluated as floats for PRT catching */
m1: float(2*(l+w));
m2: float(l+w);
m3: float(l^2);
m4: float(w^2);]]></text>
    </questionvariables>
