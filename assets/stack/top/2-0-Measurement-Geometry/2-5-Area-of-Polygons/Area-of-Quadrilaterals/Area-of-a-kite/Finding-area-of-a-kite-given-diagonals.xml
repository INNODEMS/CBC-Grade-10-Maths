    <questionvariables>
      <text>/* Randomize diagonals d1 and d2 */
d1: 6 + rand(15);
d2: 6 + rand(15);

/* Ensure they aren't the same number to maintain a distinct kite shape */
while d1 = d2 do (
    d2: 6 + rand(15)
);

/* Area calculated natively as float */
ta_float: float((1/2) * d1 * d2);

/* Common Mistakes for PRT */
m1: float(d1 * d2); /* Forgot the 1/2 multiplier */
m2: float(d1 + d2); /* Added diagonals instead of multiplying */</text>
