    <questionvariables>
      <text>letter_1: rand([C,D,E,F,G,H,I,J,K,M]);
letter_2: rand([N,O,Q,R,U,W,X,Y,Z]);
frac: 1;
/* Only pick denominators that yield a whole number when dividing 90 by (frac_2 + 1) */
frac_2: rand([2, 4, 8, 14]); 
fraction: frac/frac_2;
eq_1: letter_1=fraction*letter_2;
eq_2: letter_2=frac_2*letter_1;
simp: false;
eq_3: letter_1+letter_2=90;
eq_4: frac_2*letter_1+letter_1=90;
simp: true;
eq_5: frac_2*letter_1+letter_1=90;
coeficient: frac_2+1;
Ta_1: 90/coeficient; /* round() is no longer needed */
Ta_2: 90-Ta_1;
/*Part b of the question*/
ans_1: sin(Ta_1*pi/180);
an_1: dispdp(ans_1,4);
ans_2: cos(Ta_2*pi/180); /* Fixed: Was calculating cos(Ta_1) */
an_2: dispdp(ans_2,4);</text>
    </questionvariables>
