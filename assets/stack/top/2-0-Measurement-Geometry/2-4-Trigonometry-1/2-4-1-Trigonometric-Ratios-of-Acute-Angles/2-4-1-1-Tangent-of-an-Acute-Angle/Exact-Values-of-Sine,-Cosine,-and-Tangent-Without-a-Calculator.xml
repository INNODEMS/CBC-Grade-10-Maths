    <questionvariables>
      <text>/* Design backwards: pick an ordered pair of distinct obtuse angles from  */
/* the exact-value family. All variants use the same method (reference    */
/* angle in the second quadrant) at the same difficulty.                  */
angpair : rand([[120,135],[120,150],[135,150],[135,120],[150,120],[150,135]]);
A1 : angpair[1];
A2 : angpair[2];
ref1 : 180 - A1;
ref2 : 180 - A2;

/* Model answers: Maxima evaluates these standard angles exactly. */
ta1 : sin(A1*%pi/180);
ta2 : sin(A2*%pi/180);
ta3 : cos(A1*%pi/180);
ta4 : cos(A2*%pi/180);
ta5 : tan(A1*%pi/180);
ta6 : tan(A2*%pi/180);

/* Anticipated wrong answers: dropped minus sign in the second quadrant. */
wrong_cos_sign : -ta3;
wrong_tan_sign : -ta5;</text>
    </questionvariables>
