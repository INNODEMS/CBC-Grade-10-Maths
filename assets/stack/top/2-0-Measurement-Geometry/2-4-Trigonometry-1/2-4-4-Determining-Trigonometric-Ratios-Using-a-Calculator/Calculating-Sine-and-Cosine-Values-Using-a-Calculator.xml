    <questionvariables>
      <text>/* Create a pool of angles from 10 to 170 degrees and pick 4 distinct ones */
pool: makelist(i, i, 10, 170);
angles: rand_selection(pool, 4);

a1: angles[1];
a2: angles[2];
a3: angles[3];
a4: angles[4];

/* Evaluate to floating-point decimals natively using float() */
ans_1: float(sin(a1*pi/180));
ans_2: float(sin(a2*pi/180));
ans_3: float(cos(a3*pi/180));
ans_4: float(cos(a4*pi/180));

/* Display variables formatted to exactly 4 decimal places for your feedback block */
disp_1: dispdp(ans_1, 4);
disp_2: dispdp(ans_2, 4);
disp_3: dispdp(ans_3, 4);
disp_4: dispdp(ans_4, 4);</text>
