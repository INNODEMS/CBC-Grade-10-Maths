    <questionvariables>
      <text>/* Random angle between 5 and 90 with step 0.02 */
angle : 5 + 0.02 * rand(floor((90-5)/0.02) + 1);

/* Evaluate to floating-point decimals natively */
ans_1 : float(sin(angle * %pi/180));
ans_2 : float(cos(angle * %pi/180));
ans_3 : float(tan(angle * %pi/180));

/* Display variables formatted to exactly 4 decimal places */
disp_1 : dispdp(ans_1, 4);
disp_2 : dispdp(ans_2, 4);
disp_3 : dispdp(ans_3, 4);</text>
    </questionvariables>
