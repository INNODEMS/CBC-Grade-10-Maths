    <questionvariables>
      <text><![CDATA[/* Triangular flower bed in the first quadrant (right of the pathway = y-axis) */
x1 : 1 + rand(2);
y1 : 1 + rand(2);
x2 : x1 + 2 + rand(2);
y2 : y1;
x3 : x1 + 1;
y3 : y1 + 3 + rand(2);

/* Reflection in the y-axis: (x,y) -> (-x, y) */
rx1 : -x1;  ry1 : y1;
rx2 : -x2;  ry2 : y2;
rx3 : -x3;  ry3 : y3;

/* Wrong-axis distractor: reflection in the x-axis (x,y) -> (x, -y) */
wx1 : [x1, -y1];
wx2 : [x2, -y2];
wx3 : [x3, -y3];

/* Congruence: a reflection is an isometry, so the beds are always congruent */
ta : [["yes", true, "Yes, they are congruent"], ["no", false, "No, they are not congruent"]];
correctcong : "yes";]]></text>
    </questionvariables>
