    <questionvariables>
      <text><![CDATA[/* Fixed class intervals, width 10 */
c1_min:40$ c1_max:49$ c2_min:50$ c2_max:59$ c3_min:60$ c3_max:69$
c4_min:70$ c4_max:79$ c5_min:80$ c5_max:89$
/* Random frequencies (3..8 per group) */
f1:rand(6)+3$ f2:rand(6)+3$ f3:rand(6)+3$ f4:rand(6)+3$ f5:rand(6)+3$
total_students: f1+f2+f3+f4+f5;
/* Generate raw scores matching each frequency, then shuffle */
generate_group(nn,a,b) := makelist(rand(b-a+1)+a, k, 1, nn);
raw_data_list: append(generate_group(f1,c1_min,c1_max),generate_group(f2,c2_min,c2_max),generate_group(f3,c3_min,c3_max),generate_group(f4,c4_min,c4_max),generate_group(f5,c5_min,c5_max));
shuffled_data: random_permutation(raw_data_list);
data_str: sconcat(shuffled_data[1]);
for i:2 thru total_students do data_str: sconcat(data_str, ", ", shuffled_data[i]);]]></text>
    </questionvariables>
