    <questionvariables>
      <text><![CDATA[/* 7 UNIQUE wait-time values (2..25), sorted ascending */
candidates: makelist(i, i, 2, 25);
permw: random_permutation(candidates);
vals: sort(makelist(permw[i], i, 1, 7));
v1:vals[1]$ v2:vals[2]$ v3:vals[3]$ v4:vals[4]$ v5:vals[5]$ v6:vals[6]$ v7:vals[7]$
/* 7 frequencies summing to exactly 30 (each at least 1) */
freqs: [1,1,1,1,1,1,1];
for i:1 thru 23 do (idx: rand(7)+1, freqs[idx]: freqs[idx]+1);
f1:freqs[1]$ f2:freqs[2]$ f3:freqs[3]$ f4:freqs[4]$ f5:freqs[5]$ f6:freqs[6]$ f7:freqs[7]$
/* Build and shuffle the 30-item raw list */
raw_list: [];
for i:1 thru 7 do (for k:1 thru freqs[i] do raw_list: endcons(vals[i], raw_list));
final_data: random_permutation(raw_list);
data_str: sconcat(final_data[1]);
for i:2 thru 30 do data_str: sconcat(data_str, ", ", final_data[i]);]]></text>
    </questionvariables>
