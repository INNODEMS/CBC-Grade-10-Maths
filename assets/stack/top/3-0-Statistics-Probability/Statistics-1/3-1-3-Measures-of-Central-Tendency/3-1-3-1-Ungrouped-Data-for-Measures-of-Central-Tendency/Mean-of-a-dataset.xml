<quiz>
  <question type="stack">
    <name>
      <text>Mean of a dataset</text>
    </name>
    <questiontext format="moodle_auto_format">
      <text><![CDATA[<p>The marks scored by <strong>{@n@}</strong> students in a test are:</p>
<p style="background-color:#f9f9f9;padding:12px;border:1px solid #ddd;font-family:monospace;font-size:1.1em;">{@data_str@}</p>
<p><strong>(a)</strong> Find the total of all the marks, \( \sum x \): [[input:ans1]] [[validation:ans1]] [[feedback:prt_sum]]</p>
<p><strong>(b)</strong> Hence find the <strong>mean</strong> mark: [[input:ans2]] [[validation:ans2]] [[feedback:prt_mean]]</p>]]></text>
    </questiontext>
    <generalfeedback format="moodle_auto_format">
      <text><![CDATA[<h4>Worked solution</h4>
<p><strong>(a) Total.</strong> Add all {@n@} marks:</p>
\[ \sum x = {@sum_str@} = {@Sx@}. \]
<p><strong>(b) Mean.</strong> Divide the total by the number of values:</p>
\[ \bar{x} = \frac{\sum x}{n} = \frac{ {@Sx@} }{ {@n@} } = {@me@}. \]]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0.1</penalty>
    <hidden>0</hidden>
    <idnumber/>
    <stackversion>
      <text>2026010500</text>
    </stackversion>
    <questionvariables>
      <text><![CDATA[/* Design backwards: pick n and an integer mean m, build data summing to n*m */
n: rand(4)+7;              /* 7..10 students */
m: rand(11)+10;            /* target mean 10..20 (exact) */
np: floor(n/2);
raw: makelist(rand(5)+1, i, 1, np);
deltas: random_permutation(append(raw, -raw, if oddp(n) then [0] else []));
data: makelist(m + deltas[i], i, 1, n);
Sx: apply("+", data);      /* = n*m exactly */
me: m;                     /* the mean */
med: median(data);         /* a common wrong answer (the median) */
data_str: sconcat(data[1]);
for i:2 thru n do data_str: sconcat(data_str, ", ", data[i]);
sum_str: sconcat(data[1]);
for i:2 thru n do sum_str: sconcat(sum_str, " + ", data[i]);]]></text>
    </questionvariables>
