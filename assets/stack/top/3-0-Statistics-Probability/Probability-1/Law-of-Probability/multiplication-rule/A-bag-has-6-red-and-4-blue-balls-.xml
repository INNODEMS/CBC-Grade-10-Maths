pball1: ball1/(ball1+ball2);
pball2: ball2/(ball1+ball2);

pball11: (ball1-1)/(ball1+ball2-1);
pball12: ball1/(ball1+ball2-1);
pball21: ball2/(ball1+ball2-1);
pball22: (ball2-1)/(ball1+ball2-1);

ball1c: rand([red, yellow, green, purple, orange]);
ball2c: rand([blue, black, white, pink, brown]);

ta: pball2*pball2;
taw: pball2*pball22;
ta1: 2*pball1*pball2;
ta1w: pball2*pball12 + pball1*pball21;</text>
